{
  "name": "find-the-evidence",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run web:dev",
    "web:dev": "cd apps/web && vite",
    "web:build": "cd apps/web && tsc -b && vite build",
    "web:preview": "cd apps/web && vite preview",
    "web:test": "cd apps/web && vitest run",
    "web:test:coverage": "cd apps/web && vitest run --coverage",
    "api:dev": "python -m uvicorn app.main:app --reload --app-dir apps/api",
    "api:start": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir apps/api"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "latest",
    "vitest": "latest"
  }
}
